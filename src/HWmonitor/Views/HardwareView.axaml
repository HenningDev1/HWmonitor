<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HWmonitor.ViewModels"
             xmlns:c="using:HWmonitor.Controls"
             x:Class="HWmonitor.Views.HardwareView"
             x:DataType="vm:HardwareViewModel">
  <UserControl.Styles>
    <Style Selector="Border.stat">
      <Setter Property="Background" Value="{DynamicResource CardAltBrush}" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Margin" Value="3" />
    </Style>
    <Style Selector="Border.stat TextBlock.caps"><Setter Property="FontSize" Value="10" /></Style>
    <Style Selector="Border.stat TextBlock.v"><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="FontSize" Value="14" /></Style>
  </UserControl.Styles>

  <ScrollViewer>
    <StackPanel Margin="24,4,24,24" Spacing="16">
      <TextBlock Classes="sub" IsVisible="{Binding Loading}" Text="Reading sensors…" />

      <!-- ═════════ CPU · GPU · RAM side by side ═════════ -->
      <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">

        <!-- CPU -->
        <Border Classes="card">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
              <Border Classes="icon"><PathIcon Data="{StaticResource IconChip}" /></Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Classes="h2" Text="CPU" />
                <TextBlock Classes="sub" Text="{Binding Cpu.Name}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Grid>
            <c:Gauge Height="132" Value="{Binding Cpu.Load}" Label="Utilization" GaugeColor="{DynamicResource CpuColor}" />
            <UniformGrid Columns="3" Margin="-3,0">
              <Border Classes="stat"><StackPanel><TextBlock Classes="caps" Text="CLOCK" /><TextBlock Classes="v" Text="{Binding Cpu.Clock}" /></StackPanel></Border>
              <Border Classes="stat"><StackPanel><TextBlock Classes="caps" Text="POWER" /><TextBlock Classes="v" Text="{Binding Cpu.Power}" /></StackPanel></Border>
              <Border Classes="stat"><StackPanel><TextBlock Classes="caps" Text="TEMP" /><TextBlock Classes="v" Text="{Binding Cpu.TempText}" /></StackPanel></Border>
            </UniformGrid>
            <c:TempBar Value="{Binding Cpu.Temp}" Height="8" IsVisible="{Binding Cpu.HasTemp}" />

            <!-- CPU temperature / power need the PawnIO driver -->
            <Border Classes="tile" IsVisible="{Binding NeedsCpuDriver}" Background="#22FF9F0A">
              <StackPanel Spacing="6">
                <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="#FFB340"
                           Text="CPU temperature and power need the free PawnIO sensor driver." />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="primary" Padding="14,5" FontSize="12" Content="Install driver" Command="{Binding InstallCpuDriver}"
                          IsEnabled="{Binding !InstallingDriver}" />
                  <TextBlock Classes="sub" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding CpuDriverStatus}" />
                </StackPanel>
              </StackPanel>
            </Border>

            <TextBlock Classes="caps" Text="{Binding Cpu.Topology}" Margin="0,4,0,0" />
            <ItemsControl ItemsSource="{Binding Cpu.Cores}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CoreVM">
                  <Grid ColumnDefinitions="54,*,38,64" Height="22">
                    <TextBlock Classes="sub" Text="{Binding Title}" VerticalAlignment="Center" />
                    <c:ValueBar Grid.Column="1" Value="{Binding Load}" BarColor="{DynamicResource CoreColor}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding LoadText}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Classes="sub" Text="{Binding Clock}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- GPU (dedicated only) -->
        <ItemsControl Grid.Column="1" ItemsSource="{Binding Gpus}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="1" RowSpacing="16" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:GpuVM">
              <Border Classes="card">
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Border Classes="icon"><PathIcon Data="{StaticResource IconMonitor}" /></Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Classes="h2" Text="GPU" />
                      <TextBlock Classes="sub" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Grid>
                  <c:Gauge Height="132" Value="{Binding Load}" Label="Utilization" GaugeColor="{DynamicResource GpuColor}" />
                  <UniformGrid Columns="2" Margin="-3,0">
                    <Border Classes="stat"><StackPanel><TextBlock Classes="caps" Text="CORE CLOCK" /><TextBlock Classes="v" Text="{Binding CoreClock}" /></StackPanel></Border>
                    <Border Classes="stat"><StackPanel><TextBlock Classes="caps" Text="MEMORY CLOCK" /><TextBlock Classes="v" Text="{Binding MemClock}" /></StackPanel></Border>
                    <Border Classes="stat"><StackPanel><TextBlock Classes="caps" Text="POWER" /><TextBlock Classes="v" Text="{Binding Power}" /></StackPanel></Border>
                    <Border Classes="stat"><StackPanel><TextBlock Classes="caps" Text="FAN" /><TextBlock Classes="v" Text="{Binding Fan}" /></StackPanel></Border>
                  </UniformGrid>
                  <StackPanel Spacing="5">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Classes="caps" Text="VRAM" />
                      <TextBlock Grid.Column="1" Classes="sub" Text="{Binding VramText}" />
                    </Grid>
                    <c:ValueBar Value="{Binding VramPct}" Height="8" BarColor="{DynamicResource VramColor}" />
                  </StackPanel>
                  <StackPanel Spacing="5">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Classes="caps" Text="TEMPERATURE" />
                      <TextBlock Grid.Column="1" Classes="sub"><Run Text="{Binding TempText}" /><Run Text="  ·  hot spot " /><Run Text="{Binding HotSpot}" /></TextBlock>
                    </Grid>
                    <c:TempBar Value="{Binding Temp}" Height="8" />
                  </StackPanel>
                  <WrapPanel ItemSpacing="8" LineSpacing="4">
                    <TextBlock Classes="sub" Text="{Binding Driver}" VerticalAlignment="Center" />
                    <Border Classes="pill" Background="#33FF9F0A" IsVisible="{Binding DriverUpdate}" ToolTip.Tip="{Binding DriverHint}">
                      <Button Background="Transparent" Padding="0" Command="{Binding OpenDriverPage}">
                        <TextBlock Text="Update available" Foreground="#FF9F0A" FontSize="11" FontWeight="SemiBold" />
                      </Button>
                    </Border>
                    <Border Classes="pill" Background="#2230D158" IsVisible="{Binding !DriverUpdate}" ToolTip.Tip="{Binding DriverHint}">
                      <TextBlock Text="Up to date" Foreground="#30D158" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                  </WrapPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- RAM -->
        <Border Grid.Column="2" Classes="card">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
              <Border Classes="icon"><PathIcon Data="{StaticResource IconFlash}" /></Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Classes="h2" Text="RAM" />
                <TextBlock Classes="sub" Text="{Binding Ram.Summary}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Grid>
            <c:Gauge Height="132" Value="{Binding Ram.Load}" Label="Utilization" GaugeColor="{DynamicResource RamColor}" />
            <UniformGrid Columns="2" Margin="-3,0">
              <Border Classes="stat"><StackPanel><TextBlock Classes="caps" Text="IN USE" /><TextBlock Classes="v" Text="{Binding Ram.Used}" /></StackPanel></Border>
              <Border Classes="stat"><StackPanel><TextBlock Classes="caps" Text="AVAILABLE" /><TextBlock Classes="v" Text="{Binding Ram.Available}" /></StackPanel></Border>
              <Border Classes="stat"><StackPanel><TextBlock Classes="caps" Text="SPEED" /><TextBlock Classes="v" Text="{Binding Ram.Speed}" /></StackPanel></Border>
              <Border Classes="stat"><StackPanel><TextBlock Classes="caps" Text="MODULES" /><TextBlock Classes="v" Text="{Binding Ram.Modules}" /></StackPanel></Border>
            </UniformGrid>
            <StackPanel Spacing="5">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="caps" Text="MEMORY USAGE" />
                <TextBlock Grid.Column="1" Classes="sub" Text="{Binding Ram.Used}" />
              </Grid>
              <c:ValueBar Value="{Binding Ram.Load}" Height="8" BarColor="{DynamicResource RamColor}" />
            </StackPanel>
            <StackPanel Spacing="2">
              <TextBlock Classes="caps" Text="MODEL" />
              <TextBlock Classes="sub" Text="{Binding Ram.Brand}" TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>

      <!-- ═════════ Storage: 2 per row ═════════ -->
      <TextBlock Classes="caps" Text="STORAGE" Margin="4,4,0,0" />
      <ItemsControl ItemsSource="{Binding Disks}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><UniformGrid Columns="2" ColumnSpacing="16" RowSpacing="16" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:DiskVM">
            <Border Classes="card" Padding="16">
              <Grid ColumnDefinitions="*,190" ColumnSpacing="12">
                <StackPanel Spacing="10" VerticalAlignment="Center">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Border Classes="icon"><PathIcon Data="{StaticResource IconDisk}" /></Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Classes="h3" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="sub" Text="{Binding Size}" />
                    </StackPanel>
                  </Grid>
                  <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Classes="caps" Text="ACTIVITY" />
                      <TextBlock Grid.Column="1" Classes="sub" Text="{Binding IO}" />
                    </Grid>
                    <c:ValueBar Value="{Binding Activity}" BarColor="{DynamicResource DiskColor}" />
                  </StackPanel>
                  <StackPanel Spacing="4" IsVisible="{Binding HasTemp}">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Classes="caps" Text="TEMPERATURE" />
                      <TextBlock Grid.Column="1" Classes="sub" Text="{Binding TempText}" />
                    </Grid>
                    <c:TempBar Value="{Binding Temp}" Height="6" />
                  </StackPanel>
                </StackPanel>
                <c:Gauge Grid.Column="1" Height="100" VerticalAlignment="Center" Value="{Binding Used}" Label="Space used" Ticks="26"
                         GaugeColor="{DynamicResource DiskColor}" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
