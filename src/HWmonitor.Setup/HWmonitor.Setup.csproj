<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tiny .NET Framework 4.8 stub (ships with every Windows 10/11), the app payload is appended by build.ps1 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationManifest>setup.manifest</ApplicationManifest>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <AssemblyName>HWmonitor-Setup</AssemblyName>
    <AssemblyTitle>HWmonitor Setup</AssemblyTitle>
    <Version>1.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="Microsoft.CSharp" />
    <EmbeddedResource Include="icon.ico" LogicalName="icon.ico" />
  </ItemGroup>
</Project>
